# The m1-run.sh gate on a machine that is not the workstation: the mingw
# toolchain of ghoti-cross-mingw64:deb13 (its apt line, rebuilt here because
# that image has no committed Containerfile) plus what m1-win.sh otherwise
# borrows from the host and mounts in: wine, bison, flex, m4, python3 and the
# googletest sources.  The two symlinks make m1-env.sh's /hostusr and m1-lib.sh's
# /gt resolve to the image's own /usr and /usr/src/googletest, so the scripts
# run unchanged when M1_IN_IMAGE=1 (see m1-win.sh).
#
# Built on the EVO-X2 with `tools/evo image build`; see suite/tools/xarch/README.md
# section "Running the cross-architecture gates on the EVO-X2".  The tag names
# what is inside: base, thread model of the mingw gcc, wine major version.
# wine64 is installed WITH its recommends (fonts-wine, gnutls, dbus, ...): without them the
# wine of this image aborts with "free(): invalid pointer" while creating a prefix.
FROM docker.io/library/debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-mingw-w64-x86-64-win32 \
      g++-mingw-w64-x86-64-win32 \
      binutils-mingw-w64-x86-64 \
      make pkgconf file ca-certificates \
      bison flex m4 python3 googletest rsync util-linux \
 && apt-get install -y wine64 libwine \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr /hostusr \
 && ln -s /usr/src/googletest /gt

WORKDIR /w
