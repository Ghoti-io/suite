# Builds the text library for a BIG-ENDIAN target (s390x, 64-bit) and runs its test programs under
# qemu-s390x (text.sh s390x).
#
# It adds to ghoti-xarch:deb13 (the cross compilers of the big-endian, 32-bit and strict-alignment
# targets, C only, and qemu-user) what text's C++ tests need: a C++ cross compiler for s390x and its
# libstdc++, pkg-config, make, python3, rsync, and a googletest and a gtest_main built for s390x from
# the distribution's source.  The target has a gtest.pc and a gtest_main.pc in /opt/s390x/lib/pkgconfig,
# found first by PKG_CONFIG_PATH so that the host's x86-64 archives are never linked.
#
# The tag names what is inside.  Never :latest.
FROM localhost/ghoti-xarch:deb13

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      g++-s390x-linux-gnu \
      libstdc++-14-dev-s390x-cross \
      binutils-s390x-linux-gnu \
      pkg-config make python3 rsync libgtest-dev \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    t=s390x; d=/opt/$t; mkdir -p $d/lib/pkgconfig /tmp/gtest-build; cd /tmp/gtest-build; \
    for f in gtest-all gtest_main; do \
      $t-linux-gnu-g++ -std=c++17 -O1 -fPIC \
        -I/usr/src/googletest/googletest \
        -I/usr/src/googletest/googletest/include \
        -c /usr/src/googletest/googletest/src/$f.cc -o $f.o; \
    done; \
    $t-linux-gnu-ar rcs $d/lib/libgtest.a gtest-all.o; \
    $t-linux-gnu-ar rcs $d/lib/libgtest_main.a gtest_main.o; \
    printf "Name: gtest\nDescription: googletest for $t\nVersion: 0\nLibs: -L$d/lib -lgtest -pthread\nCflags: -I/usr/src/googletest/googletest/include\n" \
      > $d/lib/pkgconfig/gtest.pc; \
    printf "Name: gtest_main\nDescription: googletest main for $t\nVersion: 0\nRequires: gtest\nLibs: -L$d/lib -lgtest_main\nCflags: -I/usr/src/googletest/googletest/include\n" \
      > $d/lib/pkgconfig/gtest_main.pc; \
    rm -rf /tmp/gtest-build

WORKDIR /work
